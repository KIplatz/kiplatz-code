{
  "name": "kiplatz-app",
  "version": "0.3.1",
  "private": true,
  "description": "KIplatz-App für iPhone, iPad, Mac und Android (Hülle: Capacitor, Oberfläche: www/)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "nativ": "esbuild nativ/nativ.js --bundle --format=esm --target=es2020 --outfile=www/js/nativ-gebaut.js",
    "sync": "npm run nativ && npm run sauber && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "entwickeln": "python werkzeuge/entwicklung.py",
    "sauber": "python ../node-agent/sauber_ausliefern.py www auslieferung"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
